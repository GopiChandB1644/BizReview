rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCustomer() {
      return isAuthenticated() && exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    function isOwner() {
      return isAuthenticated() && exists(/databases/$(database)/documents/business_owners/$(request.auth.uid));
    }

    // Customers collection
    // Customers can read their own profile or update their profile
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == customerId;
      allow update, delete: if isAuthenticated() && request.auth.uid == customerId;
    }

    // Business Owners collection
    match /business_owners/{ownerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == ownerId;
      allow update, delete: if isAuthenticated() && request.auth.uid == ownerId;

      // Notifications subcollection for business owners
      match /notifications/{notificationId} {
        allow read, update, delete: if isAuthenticated() && request.auth.uid == ownerId;
        // Authenticated customer can create notification for the owner when submitting a review
        allow create: if isAuthenticated();
      }
    }

    // Businesses collection
    // - Public business listings: Anyone (customers and owners) can read
    // - Add business: Only authenticated business owners
    // - Edit own business: Only the owner who owns the business
    // - Delete own business: Only the owner who owns the business
    match /businesses/{businessId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
                    request.resource.data.ownerId == request.auth.uid;

      // Allow owner to update business details, or allow customer review calculation updates to averageRating/totalReviews
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        // When customer review updates ratings
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'totalReviews'])
      );

      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Reviews collection
    // - Public reading: Everyone can read reviews
    // - Add review: Authenticated customers only
    // - Edit own review: Only the author of the review
    // - Delete review: Nobody can delete others' reviews
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
                    (request.resource.data.customerId == request.auth.uid ||
                     request.resource.data.userId == request.auth.uid);

      allow update: if isAuthenticated() &&
                    (resource.data.customerId == request.auth.uid ||
                     resource.data.userId == request.auth.uid);

      allow delete: if isAuthenticated() &&
                    (resource.data.customerId == request.auth.uid ||
                     resource.data.userId == request.auth.uid);
    }

    // Legacy users collection (for backwards compatibility migration)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
